# PostgreSQL local (porta publicada pelo Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/invest_advisor

# Google AI Studio — gere uma chave em https://aistudio.google.com/apikey
GOOGLE_API_KEY=replace_with_your_google_api_key

# gemini-embedding-001 retorna vetores com 3072 dimensoes
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-flash-latest

# Langfuse e opcional; ainda nao integrado ao fluxo atual
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
